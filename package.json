{
  "name": "continued",
  "displayName": "continued",
  "description": "drop in replacement for continue.dev",
  "version": "0.0.4",
  "publisher": "AtaUlHaleem",
  "repository": {
    "type": "git",
    "url": "https://github.com/ataulhaleem/continued.git"
  },
  "engines": {
    "vscode": "^1.90.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onView:continued.chatView"
  ],
  "main": "./dist/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "continued-sidebar",
          "title": "Continued",
          "icon": "$(comment-discussion)"
        }
      ]
    },
    "views": {
      "continued-sidebar": [
        {
          "type": "webview",
          "id": "continued-chat-view",
          "name": "Chat"
        }
      ]
    },
    "commands": [
      {
        "command": "continued.addProvider",
        "title": "Continued: Add Cloud Provider"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run package",
    "compile": "npm run check-types && npm run lint && node esbuild.js",
    "watch": "npm-run-all -p watch:*",
    "watch:esbuild": "node esbuild.js --watch",
    "watch:tsc": "tsc --noEmit --watch --project tsconfig.json",
    "package": "npm run check-types && npm run lint && node esbuild.js --production",
    "compile-tests": "tsc -p . --outDir out",
    "watch-tests": "tsc -p . -w --outDir out",
    "pretest": "npm run compile-tests && npm run compile && npm run lint",
    "check-types": "tsc --noEmit",
    "lint": "eslint src",
    "test": "vscode-test"
  },
  "devDependencies": {
    "@types/vscode": "^1.90.0",
    "@types/mocha": "^10.0.10",
    "@types/node": "22.x",
    "typescript-eslint": "^8.56.1",
    "eslint": "^9.39.3",
    "esbuild": "^0.27.3",
    "npm-run-all": "^4.1.5",
    "typescript": "^5.9.3",
    "@vscode/test-cli": "^0.0.12",
    "@vscode/test-electron": "^2.5.2"
  }
}